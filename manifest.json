{
   "action": {
      "default_icon": "resources/logo/logo.png",
      "default_title": "Click to open panel"
   },
   "background": {
      "service_worker": "/scripts/service-worker.js",
      "type": "module"
   },
   "default_locale": "en",
   "description": "__MSG_extensionDescription__",
   "key": "",
   "manifest_version": 3,
   "name": "QA Utilities",
   "host_permissions": [ "<all_urls>" ],
